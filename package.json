{
  "name": "art-history-atlas",
  "version": "0.4.0",
  "private": true,
  "description": "三万年长廊：从史前洞窟到现代艺术的交互式西方美术史，以浮空画海、时代年表、艺术中心地图、人物派系关系与看画故事，串起作品、艺术家和时代。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run optimize-images && npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node scripts/validate-content.mjs",
    "test": "node --test scripts/*.test.mjs",
    "validate": "node scripts/validate-content.mjs",
    "fetch-images": "node scripts/fetch-images.mjs && npm run optimize-images",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "motion": "14.9.1"
  }
}
